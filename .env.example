# Docker Compose settings for the public portal. Copy to .env and fill in.

# Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:3002
PORTAL_PORT=3002

# The main app's database credentials (same database).
DB_HOST=celonica-web-postgres
DB_DATABASE=celonica_db
DB_USERNAME=
DB_PASSWORD=

# Same values as the main app's .env
REDIS_HOST=celonica-web-redis
FRONTEND_URL=https://ceystem.com
TEXTWARE_API_URL=
TEXTWARE_USERNAME=
TEXTWARE_PASSWORD=
TEXTWARE_SENDER_ID=
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
