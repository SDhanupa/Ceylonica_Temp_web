# ==============================================================================
# Celonica Public Portal - Root .gitignore
# Follows industrial grade practices: Zero credentials/secrets, clean repo state.
# ==============================================================================

# Secrets and environment files
.env
.env.*
.env.backup
.env.production
!.env.example
!.env.*.example
*.key
*.pem
*.cert
*.crt

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE, Editor & Tooling files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.fleet/
.nova/
.zed/

# Node / Frontend build artifacts & dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
dist/
frontend/dist/
dist-ssr/
build/
.eslintcache
.turbo/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PHP / Laravel / Composer
vendor/
backend/vendor/
backend/storage/*.key
backend/storage/pail/
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore
.phpunit.result.cache
.phpunit.cache/
Homestead.json
Homestead.yaml
/auth.json

# Database backups & dumps
*.dump
*.sql

# Tooling & agent metadata
.claude/

# Docker overrides
docker-compose.override.yml
