APP_NAME="Celonica Public Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=celonica_db
DB_USERNAME=celonica_user
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# TextWare SMS gateway. Keep the real password only in your local .env file.
TEXTWARE_API_URL=https://msg.text-ware.com/send_sms.php
TEXTWARE_USERNAME=
TEXTWARE_PASSWORD=
TEXTWARE_SENDER_ID=
